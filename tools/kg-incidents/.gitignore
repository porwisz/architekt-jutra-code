# Regenerated by `nasde run` on every invocation; contains absolute build worktree paths.
tasks/*/environment/docker-compose.yaml

# Per-run benchmark artifacts (ignore contents, keep the dir traversable so the
# curated reference run below can be un-ignored).
jobs/*

# Exception: the curated 2026-04-17 reference run (cascading-shared-dependency,
# Opus 4.6, N=3 per variant) is committed so it can be browsed via
# `nasde harbor view` without re-running the benchmark. Workspace snapshots
# are stripped from these jobs to keep the repo small — see jobs/README.md.
!jobs/README.md
!jobs/2026-04-17__*
